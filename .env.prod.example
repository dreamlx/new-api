# 生产环境配置示例
# 复制此文件为 .env.prod 并修改配置

# 数据库配置
SQL_DSN=root:your_password@tcp(localhost:3306)/new_api

# Redis配置
REDIS_CONN_STRING=redis://localhost:6379

# 运行模式
GIN_MODE=release

# 时区
TZ=Asia/Shanghai

# 日志
ERROR_LOG_ENABLED=true

# 服务端口（可选，默认3000）
# PORT=3000

# Session密钥（必须修改）
# SESSION_SECRET=your_random_secret_key

# 其他配置...
# 参考 .env.dev 文件